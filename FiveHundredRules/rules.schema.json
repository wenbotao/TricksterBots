{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trickster:fivehundred:rules:1",
  "title": "Four-player Five Hundred resolved rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metadata",
    "table",
    "deck",
    "deal",
    "auction",
    "contracts",
    "play",
    "scoring",
    "match"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name",
        "kind",
        "basedOn",
        "sources",
        "projectChoices",
        "integrationStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "preset",
            "custom",
            "example"
          ]
        },
        "basedOn": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "projectChoices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "integrationStatus": {
          "const": "specification-only"
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "players",
        "teams",
        "direction"
      ],
      "properties": {
        "players": {
          "const": 4
        },
        "teams": {
          "const": [
            [
              0,
              2
            ],
            [
              1,
              3
            ]
          ]
        },
        "direction": {
          "const": "clockwise"
        }
      }
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cards",
        "jokerOrderHighToLow"
      ],
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[4-9]|10|J|Q|K|A)[SCDH]$|^X[12]$"
          },
          "minItems": 40,
          "maxItems": 46,
          "uniqueItems": true
        },
        "jokerOrderHighToLow": {
          "type": "array",
          "items": {
            "enum": [
              "X1",
              "X2"
            ]
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "deal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handSize",
        "kittySize",
        "firstDealer",
        "fixedDealer",
        "rotation",
        "method",
        "packets",
        "kittyPosition",
        "redealRequest"
      ],
      "properties": {
        "handSize": {
          "const": 10
        },
        "kittySize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "firstDealer": {
          "enum": [
            "random",
            "fixed"
          ]
        },
        "fixedDealer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "rotation": {
          "enum": [
            "every_deal",
            "after_played_deal"
          ]
        },
        "method": {
          "enum": [
            "round_robin",
            "packets"
          ]
        },
        "packets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cardsEach",
              "kittyCards"
            ],
            "properties": {
              "cardsEach": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "kittyCards": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            }
          },
          "minItems": 0,
          "maxItems": 10
        },
        "kittyPosition": {
          "enum": [
            "after_hands",
            "interleaved_packets"
          ]
        },
        "redealRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "requiresPartnerConsent"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "ace_no_face"
              ]
            },
            "requiresPartnerConsent": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "auction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "normalMinimumByPosition",
        "normalMaximum",
        "strains",
        "passReentry",
        "selfRaise",
        "selfRaiseReopens",
        "finish",
        "allPass",
        "inkle",
        "orderLowToHigh"
