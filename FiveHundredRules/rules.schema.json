      "properties": {
        "mode": {
          "enum": [
            "multi_round",
            "single_round"
          ]
        },
        "normalMinimumByPosition": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 6,
            "maximum": 10
          },
          "minItems": 4,
          "maxItems": 4
        },
        "normalMaximum": {
          "type": "integer",
          "minimum": 6,
          "maximum": 10
        },
        "strains": {
          "type": "array",
          "items": {
            "enum": [
              "S",
              "C",
              "D",
              "H",
              "NT"
            ]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "passReentry": {
          "enum": [
            "never",
            "always",
            "on_contract_change"
          ]
        },
        "selfRaise": {
          "enum": [
            "forbidden",
            "after_others_pass"
          ]
        },
        "selfRaiseReopens": {
          "type": "boolean"
        },
        "finish": {
          "enum": [
            "all_other_seats_withdrawn",
            "three_consecutive_passes",
            "four_opportunities",
            "all_other_seats_passed_current_contract"
